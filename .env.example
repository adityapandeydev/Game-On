# Copy to .env for local development. Real environment variables take precedence.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://gameon:gameon@localhost:5433/gameon?sslmode=disable
# Required in production (>= 32 bytes). Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated origins allowed for cross-origin dev setups (not needed when the app serves the SPA).
CORS_ORIGINS=
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Directory of the built frontend to serve (the Docker image sets this).
STATIC_DIR=
